    {
        "id": "970b45d4ad848943",
        "type": "function",
        "z": "23cefcc6963de77a",
        "name": "Detection Function",
        "func": "let data=msg.payload;\n\nlet pressureMatch = data.match(/Pressure:\\s*(\\d+)/);\nlet valveMatch = data.match(/Valve:\\s*([A-Z]+)/);\nlet alarmMatch = data.match(/Alarm:\\s*([A-Z]+)/);\n\nlet pressure= 0;\nlet valve = \"UNKNOWN\";\nlet alarm = \"UNKNOWN\";\n\nif (pressureMatch !== null){\n    pressure=Number(pressureMatch[1]);\n}\n\nif (alarmMatch !== null){\n    alarm= alarmMatch[1];\n}\nif (valveMatch !== null){\n    valve=valveMatch[1];\n}\n\n//Detection rules\nif (pressure < 300 && valve == \"OPEN\"){\n    msg.payload = \"Suspicious Data Detected: LOW pressure with valve OPEN\";\n}\nelse if (pressure >=850 && alarm ==\"OFF\"){\n    msg.payload = \"Suspicious Data Detected: CRITICAL pressure with alarm OFF\";\n}\nelse if (pressure >= 700 && pressure <850 && valve == \"CLOSED\"){\n    msg.payload = \"Suspicious Data Detected: HIGH pressure with valve CLOSED\"\n}\nelse{\n    msg.payload = \"Normal\";\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
